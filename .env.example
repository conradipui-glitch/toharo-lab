# Скопируйте в .env.local и заполните. Файл .env.local в .gitignore
# и в репозиторий не попадает — это единственное место для ключей.
#
# Нужно ТОЛЬКО для генерации обложек через провайдера openai.
# Сборка и деплой сайта ключей не требуют вообще.

# Ключ. Подойдёт и прямой ключ OpenAI, и ключ агрегатора или прокси.
OPENAI_API_KEY=

# Заполнять, только если ключ НЕ напрямую от OpenAI.
# По умолчанию https://api.openai.com/v1
# OPENAI_BASE_URL=

# Модель генерации изображений. По умолчанию gpt-image-1.
# OPENAI_IMAGE_MODEL=
