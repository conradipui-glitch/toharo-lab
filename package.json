  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-posts.mjs && node scripts/build-redirects.mjs && node scripts/generate-rss.mjs",
    "build": "next build",
    "check": "node scripts/check-posts.mjs && node scripts/check-secrets.mjs --all",
